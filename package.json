{
  "name": "omniskill",
  "version": "0.1.0",
  "description": "Cross-platform skill importer, installer, and MCP bridge for coding agents",
  "type": "module",
  "bin": {
    "omniskill": "./dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "node --test --import tsx \"tests/**/*.test.ts\"",
    "check": "npm run build && npm test"
  },
  "keywords": [
    "skills",
    "claude-code",
    "codex",
    "openclaw",
    "opencode",
    "pi",
    "mcp"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
